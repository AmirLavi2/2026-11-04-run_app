<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Separate from the root, because fitsSystemWindows replaces any padding set on the same view. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/status_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <LinearLayout
                android:id="@+id/temperature_status"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/temperature_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/temperature_status"
                    android:src="@drawable/ic_temperature" />

                <TextView
                    android:id="@+id/temperature_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/time_of_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/status_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="#F0F4F7"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/gnss_status"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/status_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/gnss_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/gnss_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/gnss_status"
                android:src="@drawable/ic_gnss" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:shadowColor="#99000000"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:text="0:00:00"
        android:textColor="#FFFFFF"
        android:textSize="64sp" />

    <TextView
        android:id="@+id/distance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:shadowColor="#99000000"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:text="0.00"
        android:textColor="#FF7A1A"
        android:textSize="80sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="@string/km"
        android:textColor="#F0F4F7"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/pace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="#FFFFFF"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/gps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="#F0F4F7"
        android:textSize="16sp" />

    <Button
        android:id="@+id/action"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:text="@string/start"
        android:textSize="22sp" />

    <LinearLayout
        android:id="@+id/idle_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/idle_panel"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">

    <Button
        android:id="@+id/export_csv"
        style="@android:style/Widget.Material.Button.Borderless"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/export_csv" />

    <Button
        android:id="@+id/drive_status"
        style="@android:style/Widget.Material.Button.Borderless"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAllCaps="false" />

    <LinearLayout
        android:id="@+id/tone_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/preview_faster"
            style="@android:style/Widget.Material.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/preview_faster" />

        <Button
            android:id="@+id/preview_slower"
            style="@android:style/Widget.Material.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/preview_slower" />
    </LinearLayout>

    <ListView
        android:id="@+id/history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
